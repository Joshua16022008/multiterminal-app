  "start": [
    "kimi"
  ],
  "model": {
    "args": [
      "-m",
      "{model}"
    ],
    "format": "name",
    "static": [],
    "query": null
  },
  "resume": {
    "last": [
      "kimi",
      "--continue"
    ],
    "byId": [
      "kimi",
      "--session",
      "{sessionId}"
    ]
  },
  "prompt": null,
  "endpoints": {},
  "profileInjection": "kimi-agent-file",
  "supportsHooks": false,
  "accounts": null,
  "detect": {
    "verify": {
      "argv": [
        "kimi",
        "--help"
      ],
      "pattern": "Kimi Code"
    },
    "version": {
      "argv": [
        "kimi",
        "--version"
      ]
    }
  }
